# Bedrock model configuration
AWS_REGION=us-west-2
GROUP_RESERVATIONS_MODEL_ID=global.anthropic.claude-sonnet-4-6
GROUP_RESERVATIONS_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# GROUP_RESERVATIONS_SESSION_ROOT=.local/opentable-sessions
# Or use an AWS profile configured with `aws configure`.
# AWS_PROFILE=your-profile

# Optional OpenTable default search location.
OPENTABLE_LOCATION=San Francisco, CA

# Base URL used when the API mints shareable survey links.
PUBLIC_APP_URL=http://localhost:4173

# Google Places is the primary restaurant discovery source.
GOOGLE_MAPS_API_KEY=replace-with-a-google-maps-places-key

# Do not put OpenTable passwords here for the POC. If no session exists, the
# agent returns a login URL and the organizer completes login in their browser.
